# Garage core secrets — generate with: openssl rand -hex 32
# RPC_SECRET must be exactly 64 hex characters, or the container refuses to start.
RPC_SECRET="your-32-character-hex-string-here"
ADMIN_TOKEN="your-32-character-hex-string-here"

# Garage WebUI login — format: user:<bcrypt hash>
# IMPORTANT: escape every "$" in the bcrypt hash as "$$".
# Docker Compose interpolates env-file values, so an unescaped hash gets
# truncated ($2b$12$abcdef... silently becomes $2b$12) and login never works.
# Example: admin:$$2b$$12$$KIXk0m3Wvg7ib4vQ8pVn1O...
AUTH_USER_PASS="user:$$2b$$12$$your-bcrypt-hash-here"

# Cluster layout
GARAGE_CAPACITY=64G
GARAGE_ZONE=dc1

# Seconds the entrypoint waits for the server to come up before giving up
GARAGE_STARTUP_TIMEOUT=60
