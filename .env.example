# Garage core secrets — generate with: openssl rand -hex 32
RPC_SECRET="your-32-character-hex-string-here"
ADMIN_TOKEN="your-32-character-hex-string-here"

# Garage WebUI login 
AUTH_USER_PASS="user:$2b$12$your-bcrypt-hash-here"

# Cluster layout
GARAGE_CAPACITY=64G
GARAGE_ZONE=dc1

# Seconds the entrypoint waits for the server to come up before giving up
GARAGE_STARTUP_TIMEOUT=60
